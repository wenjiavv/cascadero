{
  "name": "cascadero-mcp",
  "version": "0.1.0",
  "description": "MCP server that lets AI agents play Cascadero (unofficial fan implementation) through text tool calls",
  "type": "module",
  "private": true,
  "bin": {
    "cascadero-mcp": "src/index.mjs"
  },
  "scripts": {
    "build": "python3 ../online/build-engine.py",
    "start": "node src/index.mjs",
    "test": "node test/smoke.mjs",
    "fuzz": "node test/fuzz.mjs 40"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.6.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wenjiavv/cascadero.git",
    "directory": "mcp"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "board-game",
    "cascadero",
    "ai-agent"
  ]
}
