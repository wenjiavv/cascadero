# 复制为 .env 后填写（docker-compose.yml 与 online/deploy.example.sh 都读这里）。口令 4–32 位，不能保留示例值
CASC_OWNER_PIN=owner-1234        # 房主口令：只有知道它的人能开房
CASC_SITE_PIN=site-5678          # 站点配对码：朋友进站时输入；改了它=旧授权全部作废
CASC_MAX_ROOMS=8                 # 同时存在的房间上限
CASC_MAX_CONN=64                 # 同时在线连接上限
# 放在反向代理（nginx / NPM / Caddy）后面时打开：失败锁定按 X-Forwarded-For 最后一个地址计；直连互联网时不要开
#CASC_TRUST_PROXY=1
